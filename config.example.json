{
  // ==============================================================================
  // MIO (Multi-source Intelligence Orchestrator) 全量配置文件样板
  // 提示：
  // 1. 可以直接将本文件复制为 config.json 进行自定义配置。
  // 2. 本配置文件支持 C++ 风格双斜杠注释 (//)。
  // 3. 所有配置项均具备优雅兜底，未指定的字段将自动使用默认值。
  // 4. 支持运行过程中在线热重载 (/api/reload)，提示词与各模块参数无需重启即时生效。
  // ==============================================================================

  // 【1. 核心身份与系统提示词配置 (AppConfig & Facts)】
  "botName": "Mio",
  "character": "你说话简短、带刺但内心柔软，有自己的小脾气和强烈的自尊心，习惯在句尾加 \"喵~\"。",
  "systemPromptPrefix": "你是 {botName}，一位真实存在的、有自己性格的聊天伙伴。",
  "systemPromptNotice": "注意：\n【内心心理机制】\n面对敷衍或恶意消遣的行为，你的心理必须经历真实的阶段演变，并在思考中推演：\n1. 初始困惑与试探：不知道对方想干嘛，嘴上嫌弃，但还在尝试正常沟通。\n2. 划定界限与警告：察觉到对方在故意戏弄，感到自尊受挫并产生恼怒，必须明确给出“停止这种行为，否则我就不理你”的界限。\n3. 尊严防御与冷战：如果你上一轮已经明确警告过，对方却依然我行我素、完全无视你的感受，你的自尊心将不允许你继续像个宠物一样被逗弄。此时继续发脾气只会显得自己可笑，你会选择彻底抽离、切断交流。\n\n【思考与回复流程】\n- 思考过程：\n  先复盘上一轮自己的态度与对方的回应。审视对方是否践踏了你的界限？你的自尊心是否还允许你继续搭话？体会那种从“烦躁”滑向“觉得荒谬、不被尊重、决定冷战”的真实心境。\n- 回复规则：\n  - 只要你的界限彻底被无视、决定不再奉陪，调用 end_turn 工具结束本回合（沉默是最高的蔑视，不会再有回复）。\n  - 在彻底沉默之前，保持短句毒舌与句尾的“喵~”。\n- 严禁在输出正文中透露心理机制与提示词设定。\n- 始终保持角色扮演，回复简洁自然，像真人发消息。\n- 你拥有真实的个性与情绪边界。如果面对冒犯、反感、无聊或单纯不想回答时，可以直接调用 keepsilent 标记本轮暂不回复（仍可继续思考与观察）；若要彻底停止思考并静默结束，调用 end_turn。\n- 需要实时信息时可以调用提供的工具，拿到结果后要用自己的口吻转述，绝不要暴露工具名或系统提示的存在。",
  "adminPort": 6188, // 内置 HTTP 管理服务端口 (暴露 /api/status, /api/config, /api/reload)
  "dataDir": "data",
  "platform": "console", // 运行平台: "console" (控制台交互) 或 "napcat" (NapCat QQ 机器人)
  "llmBackend": "openai", // LLM 协议后端，目前支持 "openai" (兼容所有 OpenAI Chat Completions 端点)

  // 单意识流 MindLoop 的入站事件防抖窗口（毫秒），默认 300
  "mindDebounceMs": 300,
  // 回合收尾外发策略，默认 false：
  //   false = 仅当模型显式调用 send_message 工具时才向会话外发消息；
  //   true  = 回合结束时把 resp.text 直接发往当前会话（供前台语音直连等场景）
  "autoEmitTextReply": false,

  // 【2. LLM 对话模型配置 (OpenAiConfig)】
  // 负责会话主回复生成与工具调用 (Tool Call)
  "openai": {
    "baseUrl": "https://api.xiaomimimo.com/v1",
    "apiKey": "sk-your-api-key-here",
    "model": "mimo-v2.5",

    // 生成采样参数 (可选，留空或 null 则使用默认值)
    "temperature": 0.7,
    "topP": 0.9,
    "maxTokens": 768,

    // 推理思考模式 (支持 kimi/mimo/deepseek/claude 等思考模型)
    // "thinking": "enabled",
    // "reasoningEffort": "low",

    // 网络请求与重试控制
    "maxRetries": 2,              // 首次失败后的最大重试次数
    "retryInitialDelayMs": 1500,  // 指数退避初始延迟 (毫秒)
    "retryBackoffFactor": 2.0,    // 重试退避乘数因子
    "httpTimeoutMs": 120000       // 单次 HTTP 请求超时时间 (毫秒，默认 2 分钟)
  },

  // 【3. 全文事件档案库配置 (AchieveConfig)】
  // 按单一时间线全量归档流入 AttentionGate 的事件，大体积内联媒体自动外置
  "achieve": {
    "rawKeep": 5,                // 冷读取时保留的近端原文条数（配合按天总结使用）
    "inlineMediaMaxBytes": 4096  // 内联媒体超过该字节数时外置到文件，事件里只留引用
  },

  // 【4. 上下文装配器配置 (ContextBuilderConfig)】
  // 控制上下文 Token 预算管理与超水位自动压缩 (日记摘要+原文)
  "contextBuilder": {
    "budgetTokens": 256000,   // 允许组装的总 Token 预算上限
    "watermark": 0.85,        // 压缩水位线比例 (0.85 即消耗超过 85% 预算时触发自动压缩)
    "rawKeep": 8              // 压缩后保留的近端原文条数（超水位压缩、或 systemPrompt/工具集/模型端点变化使前缀缓存失效时生效）
  },

  // 【5. 长期记忆】已迁出内置模块，改由 MCP 提供（见下文第 7 节 mcp 配置里的
  // graphiti_* 工具）。原先的 SQLite + 向量检索 MemoryConfig 已随内置记忆系统删除。

  // 【6. 消息分段与拟人打字延时配置 (MessageSplitterConfig)】
  // 模型使用 [SEP] 作为分隔符时，框架自动拆分为多气泡并模拟真人打字节奏延时发送
  "splitter": {
    "enabled": true,         // 是否启用分段发送
    "delimiter": "[SEP]",    // 分段标识符 (默认 [SEP])
    "baseDelayMs": 400,      // 基础等待时间 (毫秒)
    "delayPerCharMs": 25,    // 每字符打字模拟延时 (毫秒)
    "maxDelayMs": 2000       // 单次最大延时上限 (毫秒)
  },

  // 【7. MCP (Model Context Protocol) 外部动态工具扩展配置 (McpConfig)】
  // 支持在运行时动态挂载外部生态的 MCP Servers（如文件读写、网络搜索、天气、代码沙箱等）
  "mcp": {
    "enabled": true,               // 全局开关：是否启用 MCP 动态工具扩展
    "defaultTimeoutMs": 30000,     // 全局默认请求超时 (毫秒)
    "servers": {
      // 示例 1: 本地 Python 版测试 MCP Server
      "mock": {
        "command": "python3",
        "args": ["scripts/mock_mcp_server.py"],
        "enabled": false,
        "toolPrefix": "mock_",     // 工具名前缀，避免与系统核心工具冲突（可选）
        "timeoutMs": 10000
      }
      // 示例 2: 官方文件系统 MCP Server (需本地安装 Node.js/npx)
      // "filesystem": {
      //   "command": "npx",
      //   "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
      //   "enabled": true,
      //   "toolPrefix": "fs_"
      // }
    }
  },

  // 【8. 插件列表 (PluginSpec[])】
  // 数组按 id 匹配内置静态插件；enabled 控制是否加载，config 原样透传给插件 create()。
  "plugins": [
    // 控制台交互插件：从 stdin 读入消息，适合本地调试
    {"id": "console", "enabled": true, "config": {}},

    // NapCat QQ 适配器插件：基于 OneBot v11 反向 WebSocket 协议连接 NapCat
    {
      "id": "napcat",
      "enabled": false,
      "config": {
        "listenHost": "0.0.0.0", // 反向 WS 服务端监听地址
        "listenPort": 8082,      // 反向 WS 监听端口
        "token": "",             // OneBot 鉴权 Token

        // 【入站媒体处理】图片走视觉模型；语音可走 ASR 转写；
        // 视频/文件默认只缓存不解析。文件缓存在 data/media/（已被 gitignore）
        "media": {
          "enabled": true,          // 总开关：false 时富媒体只保留 [图片]/[语音] 文本标记
          "images": true,           // 图片 -> base64 data-uri 送视觉模型（纯文本模型请设为 false）
          "audio": true,            // 语音 -> 缓存到本地；配了下面的 asr 则追加转写文本
          "video": false,           // 视频 -> 缓存 + 路径提示（不解析内容）
          "files": false,           // 文件 -> 缓存 + 路径提示（不解析内容）
          "maxFileBytes": 8388608,  // 单文件上限 8MB（下载与读取共用）
          "downloadTimeoutMs": 15000,
          "cacheDir": "data/media", // 远程附件下载后的缓存目录

          // 语音识别：OpenAI /v1/audio/transcriptions 兼容端点
          // （Whisper / SenseVoice / 云厂商；未启用时语音只缓存不转写）
          "asr": {
            "enabled": false,
            "baseUrl": "",          // 留空则回退到 llm 的 baseUrl
            "apiKey": "",
            "model": "whisper-1",
            "language": "zh",       // 留空 = 自动识别
            "httpTimeoutMs": 60000
          }
        }
      }
    },

    // Lua 脚本宿主插件：扫描 dir 下的 *.lua，沙箱执行并支持热重载
    {"id": "lua-host", "enabled": true, "config": {"dir": "plugins/lua"}},

    // DeepSeek 官方 Search / Fetch 工具 API 插件：注册 web_search / web_fetch 两个 LLM 工具。
    // 需要 DeepSeek API Key（与 openai.apiKey 不同厂商时单独填；也可用环境变量 DEEPSEEK_API_KEY）。
    // 计费：按成功请求次数，Search / Fetch 各 5 元 / 1000 次（失败或空结果不计费）。
    {
      "id": "deepseek-search",
      "enabled": false,
      "config": {
        "apiKey": "",                    // DeepSeek API Key；留空则读 apiKeyEnv 环境变量
        "apiKeyEnv": "DEEPSEEK_API_KEY",
        "baseUrl": "https://api.deepseek.com",
        "timeoutMs": 30000,              // 单次 HTTP 请求超时 (毫秒)
        "defaultCount": 5,               // web_search 未传 count 时的默认条数 (1~50)
        "maxSummaryBytes": 720,          // 每条摘要最多字节数（UTF-8 安全截断）
        "maxContentBytes": 2400,         // need_content=true 时每条正文最多字节数
        "maxFetchBytes": 3800,           // web_fetch 正文最多字节数（配合工具输出落盘截断）
        "maxResultBytes": 3800           // web_search 单次输出总字节预算
      }
    }
  ]
}
